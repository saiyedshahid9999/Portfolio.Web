@{
    ViewData["Title"] = "Privacy Policy";
}

<section class="section">
    <div class="container">
        <h1 class="section-title mb-4">Privacy Policy</h1>

        <p><strong>Last updated:</strong> @DateTime.Now.ToString("dd MMM yyyy")</p>

        <p>
            This Privacy Policy explains how I, Shahid Saiyed, collect, use,
            and protect your personal data when you visit this website.
        </p>

        <h4>1. Who I Am</h4>
